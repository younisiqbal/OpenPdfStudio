<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:models="using:OpenPdfStudio.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="OpenPdfStudio.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Border.dropZone">
      <Setter Property="Background" Value="{DynamicResource DropFillBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dropZone.dragOver">
      <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.01)" />
    </Style>
    <Style Selector="Border.dropZone.dragOver Rectangle.dropOutline">
      <Setter Property="StrokeThickness" Value="2.5" />
    </Style>

    <Style Selector="Border.homeSidebar">
      <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Button.sidebarTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.sidebarTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
    </Style>
    <Style Selector="Button.sidebarTab.active">
      <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.toolCard PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SidebarFileRowTemplate" x:DataType="models:RecentFile">
      <Grid ColumnDefinitions="32,*,28" Margin="2,1" MinHeight="44">
        <Border Width="24" Height="30" CornerRadius="3"
                Background="{DynamicResource PdfBadgeBrush}"
                VerticalAlignment="Center">
          <TextBlock Text="PDF" FontSize="8" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" FontSize="11"
                     Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center"
                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ToggleStarCommand}"
                CommandParameter="{Binding}"
                ToolTip.Tip="Star or unstar this file">
          <Panel>
            <PathIcon Width="14" Height="14" Data="{StaticResource StarIcon}" Foreground="#F5B301"
                      IsVisible="{Binding IsStarred}" />
            <PathIcon Width="14" Height="14" Data="{StaticResource StarOutlineIcon}"
                      IsVisible="{Binding !IsStarred}" />
          </Panel>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="260,*">

    <!-- Recent / Starred sidebar -->
    <Border Classes="homeSidebar">
      <DockPanel Margin="12,16,12,12">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,12">
          <Button Classes="sidebarTab" Classes.active="{Binding !IsStarredSidebar}"
                  Content="Recent" Command="{Binding ShowRecentSidebarCommand}" />
          <Button Grid.Column="1" Classes="sidebarTab" Classes.active="{Binding IsStarredSidebar}"
                  Content="Starred" Command="{Binding ShowStarredSidebarCommand}" />
        </Grid>

        <Button DockPanel.Dock="Bottom" Classes="ghost" HorizontalAlignment="Stretch"
                Content="Clear list"
                Command="{Binding ClearRecentCommand}"
                IsVisible="{Binding !IsStarredSidebar}"
                IsEnabled="{Binding HasRecentFiles}"
                Margin="0,8,0,0" />

        <!-- Recent list -->
        <Panel IsVisible="{Binding !IsStarredSidebar}">
          <StackPanel Spacing="4" VerticalAlignment="Center" Margin="8"
                      IsVisible="{Binding !HasRecentFiles}">
            <TextBlock Text="No recent files" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Text="Open a PDF and it will show up here." />
          </StackPanel>
          <ListBox ItemsSource="{Binding RecentFiles}"
                   ItemTemplate="{StaticResource SidebarFileRowTemplate}"
                   Background="Transparent"
                   BorderThickness="0"
                   IsVisible="{Binding HasRecentFiles}"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Panel>

        <!-- Starred list -->
        <Panel IsVisible="{Binding IsStarredSidebar}">
          <StackPanel Spacing="4" VerticalAlignment="Center" Margin="8"
                      IsVisible="{Binding !HasStarredFiles}">
            <TextBlock Text="No starred files" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Text="Click the star next to a file to keep it here." />
          </StackPanel>
          <ListBox ItemsSource="{Binding StarredFiles}"
                   ItemTemplate="{StaticResource SidebarFileRowTemplate}"
                   Background="Transparent"
                   BorderThickness="0"
                   IsVisible="{Binding HasStarredFiles}"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Panel>
      </DockPanel>
    </Border>

    <!-- Main: brand, drop zone, tools -->
    <ScrollViewer Grid.Column="1">
      <StackPanel MaxWidth="860" Margin="32,28,32,36" Spacing="24" HorizontalAlignment="Stretch">

        <StackPanel Spacing="4">
          <TextBlock Classes="title" Text="OpenPdfStudio" />
          <TextBlock Classes="subtitle"
                     Text="Free, open-source PDF viewing and editing. Your files never leave this computer." />
        </StackPanel>

        <Border Classes="card dropZone" Classes.dragOver="{Binding IsFileDragOver}" Padding="4">
          <Grid MinHeight="120">
            <Rectangle Classes="dropOutline"
                       Stroke="{DynamicResource AccentBrush}"
                       StrokeThickness="1.5"
                       StrokeDashArray="6,5"
                       RadiusX="8" RadiusY="8"
                       Fill="Transparent"
                       IsHitTestVisible="False"
                       Margin="2" />
            <DockPanel Margin="24,18" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="ghost"
                        Content="Use as default PDF app"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MakeDefaultPdfAppCommand}" />
                <Button Classes="primary"
                        Content="Open a PDF"
                        Command="{Binding OpenFileCommand}" />
              </StackPanel>
              <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0">
                <Panel>
                  <TextBlock Text="Drop a PDF here" FontSize="18" FontWeight="SemiBold"
                             IsVisible="{Binding !IsFileDragOver}" />
                  <TextBlock Text="Release to open" FontSize="18" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"
                             IsVisible="{Binding IsFileDragOver}" />
                </Panel>
                <TextBlock Classes="muted"
                           Text="or choose a file from your computer. Press Ctrl+O at any time." />
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Quick tools" />
          <UniformGrid Columns="3">

            <Button Classes="toolCard" Margin="0,0,10,10" MinHeight="118"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OrganizePagesCommand}">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource OrganizePagesIcon}" />
                <TextBlock Text="Organize pages" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Drag to reorder, rotate, delete, or add blank pages." />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,10,10" MinHeight="118"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SplitPdfCommand}">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource SplitPdfIcon}" />
                <TextBlock Text="Split PDF" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Break a file into separate pages or ranges." />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,0,10" MinHeight="118"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MergePdfsCommand}">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource MergePdfsIcon}" />
                <TextBlock Text="Merge PDFs" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Combine several files into one document." />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,10,10" MinHeight="118"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartCommentingCommand}">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource CommentIcon}" />
                <TextBlock Text="Add comments" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Highlight text, and add notes and text boxes." />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,10,10" MinHeight="118"
                    Command="{Binding ComingSoonCommand}" CommandParameter="Scan PDF">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource ScanPdfIcon}" />
                <TextBlock Text="Scan PDF" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Turn scans or images into a searchable PDF." />
                <TextBlock Classes="hint" Text="Coming soon" />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,0,10" MinHeight="118"
                    Command="{Binding ComingSoonCommand}" CommandParameter="Protect">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource LockIcon}" />
                <TextBlock Text="Protect" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Set or remove a password." />
                <TextBlock Classes="hint" Text="Coming soon" />
              </StackPanel>
            </Button>

            <Button Classes="toolCard" Margin="0,0,10,0" MinHeight="118"
                    Command="{Binding ComingSoonCommand}" CommandParameter="Compress">
              <StackPanel Spacing="8">
                <PathIcon Data="{StaticResource CompressIcon}" />
                <TextBlock Text="Compress" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Make large files smaller." />
                <TextBlock Classes="hint" Text="Coming soon" />
              </StackPanel>
            </Button>

          </UniformGrid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
