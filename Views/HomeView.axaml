<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:models="using:OpenPdfStudio.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="OpenPdfStudio.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="FileRowTemplate" x:DataType="models:RecentFile">
      <Grid ColumnDefinitions="40,*,140,90,40" Margin="4,2">
        <Border Width="28" Height="34" CornerRadius="4"
                Background="{DynamicResource PdfBadgeBrush}"
                VerticalAlignment="Center">
          <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding LastOpened}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Size}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
        <Button Grid.Column="4" Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center"
                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ToggleStarCommand}"
                CommandParameter="{Binding}"
                ToolTip.Tip="Star or unstar this file">
          <Panel>
            <PathIcon Data="{StaticResource StarIcon}" Foreground="#F5B301" IsVisible="{Binding IsStarred}" />
            <PathIcon Data="{StaticResource StarOutlineIcon}" IsVisible="{Binding !IsStarred}" />
          </Panel>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel MaxWidth="920" Margin="36,32,36,40" Spacing="28" HorizontalAlignment="Stretch">

      <StackPanel Spacing="6">
        <TextBlock Classes="title" Text="Welcome to OpenPdfStudio" />
        <TextBlock Classes="subtitle"
                   Text="Free, open-source PDF viewing and editing. Your files never leave this computer." />
      </StackPanel>

      <Border Classes="card" Background="{DynamicResource DropFillBrush}" Padding="4">
        <Grid MinHeight="108">
          <Rectangle Stroke="{DynamicResource AccentBrush}"
                     StrokeThickness="1.5"
                     StrokeDashArray="6,5"
                     RadiusX="8" RadiusY="8"
                     Fill="Transparent"
                     IsHitTestVisible="False"
                     Margin="2" />
          <DockPanel Margin="24,18" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Classes="primary"
                    Content="Open a PDF"
                    VerticalAlignment="Center"
                    Command="{Binding OpenFileCommand}" />
            <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="Drop a PDF here" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="or choose a file from your computer. Press Ctrl+O at any time." />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>

      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="Quick tools" />
        <UniformGrid Columns="3">
          <Border Classes="card tool" Margin="0,0,10,10" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Merge PDFs" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Combine several files into one document." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
          <Border Classes="card tool" Margin="0,0,10,10" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Split PDF" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Break a file into separate pages or ranges." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
          <Border Classes="card tool" Margin="0,0,0,10" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Organize pages" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Reorder, rotate, and delete pages." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
          <Border Classes="card tool" Margin="0,0,10,0" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Add comments" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Highlight, draw, and add notes." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
          <Border Classes="card tool" Margin="0,0,10,0" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Protect" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Set or remove a password." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
          <Border Classes="card tool" MinHeight="112">
            <StackPanel Spacing="6">
              <TextBlock Text="Compress" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Make large files smaller." />
              <TextBlock Classes="hint" Text="Coming soon" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>

      <StackPanel Spacing="12">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Classes="ghost"
                  Content="Clear list"
                  Command="{Binding ClearRecentCommand}"
                  IsVisible="{Binding HasRecentFiles}" />
          <TextBlock Classes="section" Text="Recent files" VerticalAlignment="Center" />
        </DockPanel>

        <Border Classes="card" Padding="20,28" IsVisible="{Binding !HasRecentFiles}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="No recent files yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center"
                       Text="Open a PDF and it will show up here." />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0" IsVisible="{Binding HasRecentFiles}">
          <ListBox ItemsSource="{Binding RecentFiles}"
                   ItemTemplate="{StaticResource FileRowTemplate}"
                   Background="Transparent"
                   BorderThickness="0"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="Starred" />

        <Border Classes="card" Padding="20,28" IsVisible="{Binding !HasStarredFiles}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="No starred files yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center"
                       Text="Click the star next to a recent file to keep it here." />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0" IsVisible="{Binding HasStarredFiles}">
          <ListBox ItemsSource="{Binding StarredFiles}"
                   ItemTemplate="{StaticResource FileRowTemplate}"
                   Background="Transparent"
                   BorderThickness="0"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
