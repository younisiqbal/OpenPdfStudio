<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:models="using:OpenPdfStudio.Models"
             xmlns:themes="using:OpenPdfStudio.Themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="OpenPdfStudio.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Foreground="{DynamicResource HomeTextBrush}">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.homeMuted">
      <Setter Property="Foreground" Value="{DynamicResource HomeMutedBrush}" />
    </Style>

    <!-- Main canvas; the border lights up while a PDF is dragged over the window. -->
    <Style Selector="Border.homeCanvas">
      <Setter Property="Background" Value="{DynamicResource HomeCanvasBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.homeCanvas.dragOver">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.homeSidebar">
      <Setter Property="Background" Value="{DynamicResource HomeSidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HomeCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.sidebarHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource HomeCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Button.hamburger">
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hamburger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="Button.hamburger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="Button.hamburger PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <!-- Recent / Starred switch -->
    <Style Selector="Button.sidebarTab">
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.sidebarTab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HomeMutedBrush}" />
    </Style>
    <Style Selector="Button.sidebarTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="Button.sidebarTab.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Text-style button for "Clear all" -->
    <Style Selector="Button.homeLink">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.homeLink /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HomeMutedBrush}" />
    </Style>
    <Style Selector="Button.homeLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="Button.homeLink:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Star toggle inside file rows -->
    <Style Selector="Button.star">
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.star /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeCardBorderBrush}" />
    </Style>

    <!-- File rows -->
    <Style Selector="ListBox.homeFiles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.homeFiles ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.homeFiles ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="ListBox.homeFiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="ListBox.homeFiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="ListBox.homeFiles ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>

    <!-- Task cards -->
    <Style Selector="Button.taskCard">
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="MinHeight" Value="160" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.taskCard /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HomeCardBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>
    <Style Selector="Button.taskCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
      <Setter Property="BoxShadow" Value="0 4 12 0 #22000000" />
    </Style>
    <Style Selector="Button.taskCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HomeRowHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
    </Style>
    <Style Selector="Button.taskCard PathIcon">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.taskCard TextBlock.label">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.taskCard TextBlock.soon">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource HomeMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SidebarFileRowTemplate" x:DataType="models:RecentFile">
      <Grid ColumnDefinitions="28,*,Auto,Auto" MinHeight="36" ToolTip.Tip="{Binding FullPath}">
        <PathIcon Width="20" Height="20" Data="{StaticResource PageTextIcon}"
                  Foreground="{DynamicResource HomeMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                   VerticalAlignment="Center" Margin="6,0,8,0"
                   TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="2" CornerRadius="3" Padding="5,2" VerticalAlignment="Center"
                Background="{DynamicResource PdfBadgeBrush}">
          <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="White" />
        </Border>
        <Button Grid.Column="3" Classes="star" Margin="4,0,0,0"
                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ToggleStarCommand}"
                CommandParameter="{Binding}"
                ToolTip.Tip="Star or unstar this file">
          <Panel>
            <PathIcon Width="14" Height="14" Data="{StaticResource StarIcon}" Foreground="#F5B301"
                      IsVisible="{Binding IsStarred}" />
            <PathIcon Width="14" Height="14" Data="{StaticResource StarOutlineIcon}"
                      Foreground="{DynamicResource HomeMutedBrush}"
                      IsVisible="{Binding !IsStarred}" />
          </Panel>
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="260,*">

    <!-- Recent / Starred sidebar -->
    <Border Classes="homeSidebar">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="sidebarHeader" Padding="10,10,14,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="hamburger" ToolTip.Tip="Menu"
                    x:DataType="vm:MainViewModel"
                    DataContext="{Binding $parent[Window].DataContext}">
              <PathIcon Data="{StaticResource MenuIcon}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="_Open..." InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                  <MenuItem Header="Use as _default PDF app" Command="{Binding MakeDefaultPdfAppCommand}" />
                  <MenuItem Header="Se_ttings..." Command="{Binding OpenSettingsCommand}" />
                  <Separator />
                  <MenuItem Header="T_heme">
                    <MenuItem Header="Dark" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static themes:AppTheme.Dark}">
                      <MenuItem.Icon>
                        <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                  IsVisible="{Binding IsDarkTheme}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Light" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static themes:AppTheme.Light}">
                      <MenuItem.Icon>
                        <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                  IsVisible="{Binding IsLightTheme}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="System" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static themes:AppTheme.System}">
                      <MenuItem.Icon>
                        <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                  IsVisible="{Binding IsSystemTheme}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Midnight" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static themes:AppTheme.Midnight}">
                      <MenuItem.Icon>
                        <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                  IsVisible="{Binding IsMidnightTheme}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="High Contrast" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static themes:AppTheme.HighContrast}">
                      <MenuItem.Icon>
                        <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                  IsVisible="{Binding IsHighContrastTheme}" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuItem>
                  <MenuItem Header="_Help">
                    <MenuItem Header="_Documentation" Command="{Binding OpenDocumentationCommand}" />
                    <MenuItem Header="_Report an issue" Command="{Binding ReportIssueCommand}" />
                    <Separator />
                    <MenuItem Header="_About OpenPdfStudio" Command="{Binding ShowAboutCommand}" />
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="E_xit" InputGesture="Alt+F4" Command="{Binding ExitCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <TextBlock Text="New Task" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,14,14,10">
          <Button Classes="sidebarTab" Classes.active="{Binding !IsStarredSidebar}"
                  Content="Recent files" Command="{Binding ShowRecentSidebarCommand}" />
          <Button Classes="sidebarTab" Classes.active="{Binding IsStarredSidebar}"
                  Content="Starred" Command="{Binding ShowStarredSidebarCommand}" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Classes="homeLink"
                Content="Clear all"
                Command="{Binding ClearRecentCommand}"
                IsVisible="{Binding !IsStarredSidebar}"
                IsEnabled="{Binding HasRecentFiles}"
                Margin="14,8,14,12" />

        <Panel IsVisible="{Binding !IsStarredSidebar}" Margin="10,0">
          <StackPanel Spacing="4" VerticalAlignment="Center" Margin="8"
                      IsVisible="{Binding !HasRecentFiles}">
            <TextBlock Text="No recent files" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="homeMuted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="Open a PDF and it will show up here." />
          </StackPanel>
          <ListBox Classes="homeFiles"
                   ItemsSource="{Binding RecentFiles}"
                   ItemTemplate="{StaticResource SidebarFileRowTemplate}"
                   IsVisible="{Binding HasRecentFiles}"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Panel>

        <Panel IsVisible="{Binding IsStarredSidebar}" Margin="10,0">
          <StackPanel Spacing="4" VerticalAlignment="Center" Margin="8"
                      IsVisible="{Binding !HasStarredFiles}">
            <TextBlock Text="No starred files" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="homeMuted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="Click the star next to a file to keep it here." />
          </StackPanel>
          <ListBox Classes="homeFiles"
                   ItemsSource="{Binding StarredFiles}"
                   ItemTemplate="{StaticResource SidebarFileRowTemplate}"
                   IsVisible="{Binding HasStarredFiles}"
                   DoubleTapped="OnRecentFileDoubleTapped" />
        </Panel>
      </DockPanel>
    </Border>

    <!-- New Task dashboard -->
    <Border Grid.Column="1" Classes="homeCanvas" Classes.dragOver="{Binding IsFileDragOver}">
      <DockPanel>
        <Panel DockPanel.Dock="Bottom" Margin="0,8,0,14" HorizontalAlignment="Center">
          <TextBlock Classes="homeMuted" FontSize="13" Text="Drag PDFs anywhere to open"
                     IsVisible="{Binding !IsFileDragOver}" />
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="Release to open"
                     Foreground="{DynamicResource AccentBrush}"
                     IsVisible="{Binding IsFileDragOver}" />
        </Panel>

        <ScrollViewer>
          <StackPanel MaxWidth="900" Margin="32,26,16,8" HorizontalAlignment="Stretch" Spacing="22">

            <DockPanel Margin="0,0,16,0">
              <Button DockPanel.Dock="Right" Classes="primary" VerticalAlignment="Top"
                      Content="Open a PDF" Command="{Binding OpenFileCommand}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="New Task" />
                <TextBlock Classes="homeMuted" FontSize="15" Text="Choose what you want to do" />
              </StackPanel>
            </DockPanel>

            <UniformGrid Columns="3">

              <Button Classes="taskCard" Command="{Binding OpenFileCommand}"
                      ToolTip.Tip="Open a PDF from your computer (Ctrl+O)">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource PageTextIcon}" Foreground="#0E9AA7" />
                  <TextBlock Classes="label" Text="Open PDF" />
                </StackPanel>
              </Button>

              <Button Classes="taskCard" Command="{Binding ComingSoonCommand}" CommandParameter="Scan to PDF"
                      ToolTip.Tip="Turn scans or images into a PDF">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource ScannerIcon}" Foreground="#1A73E8" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="Scan to PDF" />
                    <TextBlock Classes="soon" Text="Coming soon" />
                  </StackPanel>
                </StackPanel>
              </Button>

              <Button Classes="taskCard" Command="{Binding ComingSoonCommand}" CommandParameter="OCR"
                      ToolTip.Tip="Recognize text in scanned pages so it can be searched and copied">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource SearchIcon}" Foreground="#F07B2B" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="OCR Make Searchable" />
                    <TextBlock Classes="soon" Text="Coming soon" />
                  </StackPanel>
                </StackPanel>
              </Button>

              <Button Classes="taskCard" Command="{Binding ComingSoonCommand}" CommandParameter="Convert to Word"
                      ToolTip.Tip="Export a PDF as an editable Word document">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource WordFileIcon}" Foreground="#2E9E4F" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="Convert to Word" />
                    <TextBlock Classes="soon" Text="Coming soon" />
                  </StackPanel>
                </StackPanel>
              </Button>

              <Button Classes="taskCard"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OrganizePagesCommand}"
                      ToolTip.Tip="Drag to reorder, rotate, delete, or add blank pages">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource FileMultipleIcon}" Foreground="#7B4FD6" />
                  <TextBlock Classes="label" Text="Organize Pages" />
                </StackPanel>
              </Button>

              <Button Classes="taskCard" Command="{Binding ComingSoonCommand}" CommandParameter="Compare"
                      ToolTip.Tip="Show the differences between two PDFs">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource CompareIcon}" Foreground="#E8A317" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="Compare" />
                    <TextBlock Classes="soon" Text="Coming soon" />
                  </StackPanel>
                </StackPanel>
              </Button>

              <Button Classes="taskCard"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SplitPdfCommand}"
                      ToolTip.Tip="Break a file into separate pages or ranges">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource SplitPdfIcon}" Foreground="#D9534F" />
                  <TextBlock Classes="label" Text="Split PDF" />
                </StackPanel>
              </Button>

              <Button Classes="taskCard"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MergePdfsCommand}"
                      ToolTip.Tip="Combine several files into one document">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource MergePdfsIcon}" Foreground="#2B7BB9" />
                  <TextBlock Classes="label" Text="Merge PDFs" />
                </StackPanel>
              </Button>

              <Button Classes="taskCard"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartCommentingCommand}"
                      ToolTip.Tip="Highlight text, and add notes and text boxes">
                <StackPanel Spacing="14">
                  <PathIcon Data="{StaticResource CommentIcon}" Foreground="#C2185B" />
                  <TextBlock Classes="label" Text="Add Comments" />
                </StackPanel>
              </Button>

            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
