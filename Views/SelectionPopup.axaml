<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:models="using:OpenPdfStudio.Models"
             x:Class="OpenPdfStudio.Views.SelectionPopup"
             x:DataType="vm:DocumentViewModel">
  <Border Background="{DynamicResource SystemChromeLowColor}"
          BorderBrush="{DynamicResource SystemBaseLowColor}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="4"
          BoxShadow="0 4 14 0 #40000000">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Classes="icon" Command="{Binding CopySelectionCommand}" ToolTip.Tip="Copy (Ctrl+C)">
        <PathIcon Data="{StaticResource CopyIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding MarkupSelectionCommand}" CommandParameter="Highlight" ToolTip.Tip="Highlight">
        <PathIcon Data="{StaticResource HighlightIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding MarkupSelectionCommand}" CommandParameter="StrikeOut" ToolTip.Tip="Strikeout">
        <PathIcon Data="{StaticResource StrikethroughIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding MarkupSelectionCommand}" CommandParameter="Underline" ToolTip.Tip="Underline">
        <PathIcon Data="{StaticResource UnderlineIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding MarkupSelectionCommand}" CommandParameter="Squiggly" ToolTip.Tip="Squiggly underline">
        <PathIcon Data="{StaticResource SquigglyIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding ComingSoonCommand}" CommandParameter="Bookmark" ToolTip.Tip="Bookmark (coming soon)">
        <PathIcon Data="{StaticResource BookmarkIcon}" />
      </Button>
      <Button Classes="icon" Command="{Binding UseAnnotationToolCommand}" CommandParameter="{x:Static models:AnnotationTool.Textbox}" ToolTip.Tip="Textbox">
        <PathIcon Data="{StaticResource TextBoxIcon}" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
