<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenPdfStudio.ViewModels"
        xmlns:themes="using:OpenPdfStudio.Themes"
        xmlns:views="using:OpenPdfStudio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OpenPdfStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-logo.ico"
        Title="OpenPdfStudio"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding OpenAdvancedSearchCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ToggleRulerCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+V" Command="{Binding PasteInPlaceCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleReadModeCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ActualSizeCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding ActualSizeCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding FitWidthCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad2" Command="{Binding FitWidthCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Add" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding ActiveDocument.UndoCommand, FallbackValue={x:Null}}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" />
  </Window.KeyBindings>

  <DockPanel>

    <Menu DockPanel.Dock="Top" IsVisible="{Binding IsChromeVisible}">
      <MenuItem Header="_File">
        <MenuItem Header="_Open..." InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <MenuItem Header="Open _Recent">
          <MenuItem Header="Clear recent files" Command="{Binding Home.ClearRecentCommand}" />
        </MenuItem>
        <MenuItem Header="_Close tab" InputGesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="_Print..." InputGesture="Ctrl+P" Command="{Binding PrintCommand}" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Alt+F4" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding ActiveDocument.UndoCommand, FallbackValue={x:Null}}" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" />
        <Separator />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <MenuItem Header="Paste in Pla_ce" InputGesture="Ctrl+Alt+V" Command="{Binding PasteInPlaceCommand}" />
        <Separator />
        <MenuItem Header="_Find..." InputGesture="Ctrl+F" Command="{Binding FindCommand}" />
        <MenuItem Header="Find _Next" InputGesture="F3" Command="{Binding FindNextCommand}" />
        <MenuItem Header="Find _Previous" InputGesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
        <MenuItem Header="_Advanced Search..." InputGesture="Ctrl+Shift+F" Command="{Binding OpenAdvancedSearchCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom _In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="Zoom _Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="_Actual Size" InputGesture="Ctrl+1" Command="{Binding ActualSizeCommand}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                      IsVisible="{Binding ActiveDocument.IsActualSize, FallbackValue=False}" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Fit _Page" InputGesture="Ctrl+0" Command="{Binding FitPageCommand}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                      IsVisible="{Binding ActiveDocument.IsFitPage, FallbackValue=False}" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Fit _Width" InputGesture="Ctrl+2" Command="{Binding FitWidthCommand}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                      IsVisible="{Binding ActiveDocument.IsFitWidth, FallbackValue=False}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Rotate _Right" InputGesture="Ctrl+Shift+OemPlus" Command="{Binding RotateClockwiseCommand}" />
        <Separator />
        <MenuItem Header="Rea_d Mode" InputGesture="Ctrl+H" Command="{Binding ToggleReadModeCommand}" />
        <MenuItem Header="_Full Screen" InputGesture="F11" Command="{Binding ToggleFullScreenCommand}" />
        <Separator />
        <MenuItem Header="_Comment" Command="{Binding SelectRibbonTabCommand}" CommandParameter="Comment">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                      IsVisible="{Binding IsCommentTab}" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Ruler" InputGesture="Ctrl+R" Command="{Binding ToggleRulerCommand}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                      IsVisible="{Binding ActiveDocument.IsRulerVisible, FallbackValue=False}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Organize">
        <MenuItem Header="_Merge PDFs..." IsEnabled="False" />
        <MenuItem Header="_Split PDF..." IsEnabled="False" />
        <MenuItem Header="_Rotate / Delete pages" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Protect">
        <MenuItem Header="Add _password..." IsEnabled="False" />
        <MenuItem Header="_Compress..." IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Documentation" IsEnabled="False" />
        <MenuItem Header="_Report an issue" IsEnabled="False" />
        <MenuItem Header="_About OpenPdfStudio" IsEnabled="False" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding IsChromeVisible}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Text="{Binding Version}" />
        <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Margin="0,0,24,0"
                   Text="{Binding ActiveDocument.PageStatus, FallbackValue=''}"
                   IsVisible="{Binding HasActiveDocument}" />
        <TextBlock FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsChromeVisible}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6,10,0">
      <DockPanel>
      <views:TopSearchBox DockPanel.Dock="Right" DataContext="{Binding TopSearch}"
                          VerticalAlignment="Center" Margin="12,0,0,6" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Button Classes="tab" Classes.active="{Binding IsActive}"
                        Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding FilePath}"
                        Padding="12,7,6,7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="14" Height="17" CornerRadius="2"
                            Background="{DynamicResource PdfBadgeBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}" MaxWidth="180"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" IsVisible="{Binding IsModified}"
                             ToolTip.Tip="Unsaved changes" />
                    <Button Classes="tabClose" Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close (Ctrl+W)" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource CloseIcon}" />
                    </Button>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="ghost"
                  ToolTip.Tip="Open a PDF (Ctrl+O)"
                  Command="{Binding OpenFileCommand}"
                  VerticalAlignment="Center"
                  Margin="4,0,0,4">
            <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <views:RibbonBar DockPanel.Dock="Top" IsVisible="{Binding ShowRibbon}" />

    <Border DockPanel.Dock="Left"
            IsVisible="{Binding IsChromeVisible}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,1,0"
            Padding="6,8"
            Width="76">
      <Border.Styles>
        <Style Selector="Button.nav">
          <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style Selector="Button.nav PathIcon">
          <Setter Property="Width" Value="16" />
          <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.nav PathIcon.chevron">
          <Setter Property="Width" Value="7" />
          <Setter Property="Height" Value="7" />
        </Style>
      </Border.Styles>
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Classes="nav" ToolTip.Tip="Change theme">
          <Button.Flyout>
            <MenuFlyout Placement="RightEdgeAlignedBottom">
              <MenuItem Header="Dark"
                        Command="{Binding SetThemeCommand}"
                        CommandParameter="{x:Static themes:AppTheme.Dark}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"
                            IsVisible="{Binding IsDarkTheme}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Light"
                        Command="{Binding SetThemeCommand}"
                        CommandParameter="{x:Static themes:AppTheme.Light}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"
                            IsVisible="{Binding IsLightTheme}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="System"
                        Command="{Binding SetThemeCommand}"
                        CommandParameter="{x:Static themes:AppTheme.System}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"
                            IsVisible="{Binding IsSystemTheme}" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Midnight"
                        Command="{Binding SetThemeCommand}"
                        CommandParameter="{x:Static themes:AppTheme.Midnight}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"
                            IsVisible="{Binding IsMidnightTheme}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="High Contrast"
                        Command="{Binding SetThemeCommand}"
                        CommandParameter="{x:Static themes:AppTheme.HighContrast}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"
                            IsVisible="{Binding IsHighContrastTheme}" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Spacing="2">
            <PathIcon Data="{StaticResource PaletteIcon}" />
            <TextBlock Text="Theme" FontSize="11" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button DockPanel.Dock="Bottom" Classes="nav" ToolTip.Tip="Add or remove rail items">
          <Button.Flyout>
            <Flyout Placement="RightEdgeAlignedBottom">
              <Border Padding="8,6" MinWidth="220" MaxHeight="440">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding RailGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RailPinGroup">
                        <StackPanel Margin="0,6,0,2">
                          <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.55"
                                     FontWeight="SemiBold" Margin="8,0,8,4" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RailPinItem">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsPinned}"
                                          Margin="8,2" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Flyout>
          </Button.Flyout>
          <StackPanel Spacing="2">
            <PathIcon Data="{StaticResource PlusIcon}" />
            <TextBlock Text="Add" FontSize="11" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <views:RailBar />
      </DockPanel>
    </Border>

    <Panel DockPanel.Dock="Right" IsVisible="{Binding AdvancedSearch.IsOpen}">
      <views:AdvancedSearchPanel DataContext="{Binding AdvancedSearch}" />
    </Panel>

    <Panel>
      <ContentControl Content="{Binding CurrentPage}"
                      Background="{DynamicResource SystemRegionColor}" />
      <Button Classes="primary"
              IsVisible="{Binding IsPresenting}"
              Command="{Binding ExitPresentationModeCommand}"
              Content="{Binding PresentationExitText}"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,20" Opacity="0.85" />
    </Panel>
  </DockPanel>
</Window>
