<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenPdfStudio.ViewModels"
        xmlns:themes="using:OpenPdfStudio.Themes"
        xmlns:views="using:OpenPdfStudio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="OpenPdfStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-logo.ico"
        Title="{Binding ActiveDocument.FileName, StringFormat='{}{0} - OpenPdfStudio', FallbackValue=OpenPdfStudio, TargetNullValue=OpenPdfStudio}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding OpenAdvancedSearchCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ToggleRulerCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+V" Command="{Binding PasteInPlaceCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleReadModeCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ActualSizeCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding ActualSizeCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding FitPageCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding FitWidthCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad2" Command="{Binding FitWidthCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Add" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding ActiveDocument.UndoCommand, FallbackValue={x:Null}}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
    </Style>
    <Style Selector="Button.docTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,2,4,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.docTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
    </Style>
    <Style Selector="Button.docTab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.docTab.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemRegionColor}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.docTab Button.tabClose">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.quick">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quick /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.quick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CaptionPressedBrush}" />
    </Style>
    <Style Selector="Button.quick:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.quick:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.quick PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.quick PathIcon.chevron">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A32315" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.caption PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="36"
            Background="{DynamicResource TitleBarBrush}"
            IsVisible="{Binding !IsFullScreen}">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" Margin="8,0,4,0"
                    IsVisible="{Binding HasActiveDocument}">
          <Button Classes="quick" Command="{Binding OpenFileCommand}" ToolTip.Tip="Open (Ctrl+O)">
            <PathIcon Data="{StaticResource FolderIcon}" />
          </Button>
          <Button Classes="quick" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
            <PathIcon Data="{StaticResource SaveIcon}" />
          </Button>
          <Button Classes="quick" Command="{Binding PrintCommand}" ToolTip.Tip="Print (Ctrl+P)">
            <PathIcon Data="{StaticResource PrintIcon}" />
          </Button>
          <Button Classes="quick" Command="{Binding ActiveDocument.UndoCommand, FallbackValue={x:Null}}" ToolTip.Tip="Undo (Ctrl+Z)">
            <PathIcon Data="{StaticResource UndoIcon}" />
          </Button>
          <Button Classes="quick" Command="{Binding ActiveDocument.RedoCommand, FallbackValue={x:Null}}" ToolTip.Tip="Redo (Ctrl+Y)">
            <PathIcon Data="{StaticResource RedoIcon}" />
          </Button>
          <Button Classes="quick" Width="40" ToolTip.Tip="Hand or Select tool">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Hand tool" Command="{Binding ActiveDocument.UseHandToolCommand, FallbackValue={x:Null}}">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                              IsVisible="{Binding ActiveDocument.IsHandTool, FallbackValue=False}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select text" Command="{Binding ActiveDocument.UseSelectToolCommand, FallbackValue={x:Null}}">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                              IsVisible="{Binding ActiveDocument.IsSelectTool, FallbackValue=False}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select annotation" Command="{Binding ActiveDocument.UseSelectAnnotationToolCommand, FallbackValue={x:Null}}">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                              IsVisible="{Binding ActiveDocument.IsSelectAnnotationTool, FallbackValue=False}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Panel>
                <PathIcon Data="{StaticResource HandIcon}" IsVisible="{Binding !ActiveDocument.IsSelectTool, FallbackValue=True}" />
                <PathIcon Data="{StaticResource SelectIcon}" IsVisible="{Binding ActiveDocument.IsSelectTool, FallbackValue=False}" />
              </Panel>
              <PathIcon Classes="chevron" Data="{StaticResource ChevronDownIcon}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Column="1" x:Name="TitleDragArea" Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
          <Panel>
            <TextBlock Text="OpenPdfStudio" IsVisible="{Binding IsHomeActive}"
                       Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarForegroundBrush}"
                       IsHitTestVisible="False" />
            <TextBlock Text="{Binding ActiveDocument.FileName, StringFormat='{}{0} - OpenPdfStudio', FallbackValue=''}"
                       IsVisible="{Binding HasActiveDocument}"
                       Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource TitleBarForegroundBrush}"
                       IsHitTestVisible="False" />
          </Panel>
        </Border>

        <views:TopSearchBox Grid.Column="2" DataContext="{Binding TopSearch}"
                            IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasActiveDocument}"
                            VerticalAlignment="Center" />

        <Border Grid.Column="3" x:Name="TitleDragAreaRight" Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped" />

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
            <PathIcon Data="{StaticResource CaptionMinimizeIcon}" />
          </Button>
          <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
            <Panel>
              <PathIcon x:Name="MaximizeGlyph" Data="{StaticResource CaptionMaximizeIcon}" />
              <PathIcon x:Name="RestoreGlyph" Data="{StaticResource CaptionRestoreIcon}" IsVisible="False" />
            </Panel>
          </Button>
          <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close">
            <PathIcon Data="{StaticResource CaptionCloseIcon}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding ShowStatusBar}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Text="{Binding Version}" />
        <TextBlock FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <views:RibbonBar DockPanel.Dock="Top" IsVisible="{Binding ShowDocumentToolbar}" />

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowTabStrip}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,0,1"
            Padding="4,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Classes="docTab" Classes.active="{Binding IsHomeActive}"
                  Command="{Binding ShowHomeCommand}" ToolTip.Tip="Start: open, organize, split and merge PDFs">
            <TextBlock Text="Start" Margin="4,0,24,0" VerticalAlignment="Center" />
          </Button>
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Button Classes="docTab" Classes.active="{Binding IsActive}"
                        Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding FilePath}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding FileName}" MaxWidth="160"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" IsVisible="{Binding IsModified}"
                             ToolTip.Tip="Unsaved changes" />
                    <Button Classes="tabClose" Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close (Ctrl+W)" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource CloseIcon}" />
                    </Button>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="tabClose" Width="24" Height="22" Margin="4,0,0,0"
                  ToolTip.Tip="Open a PDF (Ctrl+O)"
                  Command="{Binding OpenFileCommand}"
                  VerticalAlignment="Center">
            <PathIcon Data="{StaticResource PlusIcon}" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Panel DockPanel.Dock="Right" IsVisible="{Binding AdvancedSearch.IsOpen}">
      <views:AdvancedSearchPanel DataContext="{Binding AdvancedSearch}" />
    </Panel>

    <Panel>
      <ContentControl Content="{Binding CurrentPage}"
                      Background="{DynamicResource SystemRegionColor}" />
      <Button Classes="primary"
              IsVisible="{Binding IsPresenting}"
              Command="{Binding ExitPresentationModeCommand}"
              Content="{Binding PresentationExitText}"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,20" Opacity="0.85" />
    </Panel>
  </DockPanel>
</Window>
