<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             x:Class="OpenPdfStudio.Views.AdvancedSearchPanel"
             x:DataType="vm:AdvancedSearchViewModel">
  <Border Width="340"
          Background="{DynamicResource SystemChromeLowColor}"
          BorderBrush="{DynamicResource HairlineBrush}"
          BorderThickness="1,0,0,0">
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="10,6,10,0"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
        <Button Classes="tab active" HorizontalAlignment="Left" Padding="12,6,6,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Search" Foreground="{DynamicResource AccentHoverBrush}" VerticalAlignment="Center" />
            <Button Classes="tabClose" Command="{Binding CloseCommand}" ToolTip.Tip="Close Advanced Search"
                    VerticalAlignment="Center">
              <PathIcon Data="{StaticResource CloseIcon}" />
            </Button>
          </StackPanel>
        </Button>
      </Border>

      <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8" Spacing="8">
        <TextBlock Text="Where would you like to search?" />
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AdvancedSearchViewModel.ScopeNames}"
                  SelectedIndex="{Binding ScopeIndex}" />

        <StackPanel Spacing="6" IsVisible="{Binding IsFolderScope}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" Margin="4,0,0,0"
                    Command="{Binding BrowseFolderCommand}" ToolTip.Tip="Choose a folder">
              <PathIcon Data="{StaticResource FolderIcon}" />
            </Button>
            <TextBox Text="{Binding FolderPath}" PlaceholderText="Folder to search" />
          </DockPanel>
          <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" />
        </StackPanel>

        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AdvancedSearchViewModel.MatchModeNames}"
                  SelectedIndex="{Binding MatchModeIndex}" />

        <TextBlock Text="What word or phrase would you like to search for?" TextWrapping="Wrap" />
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Search for...">
          <TextBox.InnerRightContent>
            <PathIcon Data="{StaticResource SearchIcon}" Width="14" Height="14" Margin="0,0,10,0" Opacity="0.7" />
          </TextBox.InnerRightContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchOrStopCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <StackPanel Spacing="0" IsVisible="{Binding ShowOptions}">
          <CheckBox Content="Whole Words Only" IsChecked="{Binding WholeWords}" />
          <CheckBox Content="Case-Sensitive" IsChecked="{Binding CaseSensitive}" />
          <CheckBox Content="Include Page Text" IsChecked="{Binding IncludePageText}" />
          <CheckBox Content="Include Bookmarks" IsChecked="{Binding IncludeBookmarks}" />
          <CheckBox Content="Include Comments" IsChecked="{Binding IncludeComments}" />
          <CheckBox Content="Include Attachments" IsChecked="{Binding IncludeAttachments}" />
          <CheckBox Content="Stemming" IsChecked="{Binding Stemming}"
                    ToolTip.Tip="Also find other forms of each word, for example run, runs, and running" />
          <CheckBox Content="Highlight All Text" IsChecked="{Binding HighlightAll}" />
        </StackPanel>

        <Button Classes="link" HorizontalAlignment="Left" Content="{Binding MoreLessText}"
                Command="{Binding ToggleOptionsCommand}" />

        <Button Classes="primary" HorizontalAlignment="Left" MinWidth="110" Padding="18,8"
                HorizontalContentAlignment="Center"
                Content="{Binding SearchButtonText}" Command="{Binding SearchOrStopCommand}" />

        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    BorderBrush="{DynamicResource HairlineBrush}">
        <ItemsControl ItemsSource="{Binding Results}" Margin="6,0,6,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchResultGroup">
              <StackPanel Margin="0,4,0,0">
                <ToggleButton Classes="result" IsChecked="{Binding IsExpanded}" ToolTip.Tip="{Binding FilePath}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Classes="muted" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="12" Height="15" CornerRadius="2" VerticalAlignment="Center"
                              Background="{DynamicResource PdfBadgeBrush}" />
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 MaxWidth="200" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                </ToggleButton>

                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" Margin="12,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultItem">
                      <Button Classes="result"
                              Command="{Binding $parent[UserControl].((vm:AdvancedSearchViewModel)DataContext).OpenResultCommand}"
                              CommandParameter="{Binding}">
                        <DockPanel>
                          <Panel DockPanel.Dock="Left" Width="16" Margin="0,2,8,0" VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource PageTextIcon}" Width="13" Height="13" Opacity="0.7"
                                      IsVisible="{Binding IsPageText}" />
                            <PathIcon Data="{StaticResource BookmarkIcon}" Width="13" Height="13" Opacity="0.7"
                                      IsVisible="{Binding IsBookmark}" />
                            <PathIcon Data="{StaticResource CommentIcon}" Width="13" Height="13" Opacity="0.7"
                                      IsVisible="{Binding IsComment}" />
                            <PathIcon Data="{StaticResource AttachmentIcon}" Width="13" Height="13" Opacity="0.7"
                                      IsVisible="{Binding IsAttachment}" />
                          </Panel>
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Location}" Classes="muted" FontSize="11" />
                            <TextBlock TextWrapping="Wrap" FontSize="12"><Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
