<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenPdfStudio.Views.NoteMiniBar">
  <Border Background="{DynamicResource SystemChromeLowColor}"
          BorderBrush="{DynamicResource SystemBaseLowColor}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="4"
          BoxShadow="0 2 10 0 #40000000">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button x:Name="CommentButton" Classes="icon" ToolTip.Tip="Note">
        <PathIcon Data="{StaticResource CommentIcon}" Width="14" Height="14" />
      </Button>
      <Button x:Name="ColorButton" Classes="icon" ToolTip.Tip="Note colour">
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <UniformGrid x:Name="ColorGrid" Columns="8" Width="160" />
          </Flyout>
        </Button.Flyout>
        <Ellipse x:Name="Swatch" Width="14" Height="14" Stroke="#333" StrokeThickness="1" />
      </Button>
      <Button x:Name="SettingsButton" Classes="icon" ToolTip.Tip="Note settings">
        <PathIcon Data="{StaticResource EqualizerIcon}" Width="14" Height="14" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
