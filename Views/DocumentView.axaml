<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:views="using:OpenPdfStudio.Views"
             xmlns:controls="using:OpenPdfStudio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="OpenPdfStudio.Views.DocumentView"
             x:DataType="vm:DocumentViewModel"
             Focusable="True">

  <UserControl.Styles>
    <Style Selector="Button.thumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
    </Style>
    <Style Selector="Button.thumb.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <views:ViewerBottomBar DockPanel.Dock="Bottom" IsVisible="{Binding ShowBottomBar}" />
    <Border DockPanel.Dock="Right" IsVisible="{Binding ShowFormatPanel}">
      <views:FormatPanel DataContext="{Binding Format}" />
    </Border>

    <Border DockPanel.Dock="Left"
            Width="152"
            IsVisible="{Binding ShowThumbnails}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,1,0">
      <ScrollViewer x:Name="ThumbScroller" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ThumbnailHost" ItemsSource="{Binding Pages}" Margin="0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PdfPageViewModel">
              <Button Classes="thumb" Classes.current="{Binding IsCurrent}"
                      Margin="0,0,0,8" Click="OnThumbnailClick"
                      ToolTip.Tip="{Binding PageNumber, StringFormat='Page {0}'}">
                <StackPanel Spacing="4">
                  <LayoutTransformControl HorizontalAlignment="Center" LayoutTransform="{Binding PageTransform}">
                    <Border Width="{x:Static vm:PdfPageViewModel.ThumbnailWidth}"
                            Height="{Binding ThumbnailHeight}"
                            Background="White"
                            BoxShadow="0 1 4 0 #33000000">
                      <Image Source="{Binding Thumbnail}" Stretch="Fill" />
                    </Border>
                  </LayoutTransformControl>
                  <TextBlock Text="{Binding PageNumber}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid x:Name="PageArea" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Inches" Command="{Binding SetRulerUnitCommand}" CommandParameter="Inches">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerInches}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Centimeters" Command="{Binding SetRulerUnitCommand}" CommandParameter="Centimeters">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerCentimeters}" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Hide ruler" InputGesture="Ctrl+R" Command="{Binding ToggleRulerCommand}" />
        </ContextMenu>
      </Grid.ContextMenu>

      <Border x:Name="RulerCorner" Grid.Row="0" Grid.Column="0" Width="20" Height="20"
              IsVisible="{Binding IsRulerVisible}"
              Background="{DynamicResource SystemChromeLowColor}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,1" />
      <controls:RulerControl x:Name="TopRuler" Grid.Row="0" Grid.Column="1" Height="20"
                             Orientation="Horizontal"
                             IsVisible="{Binding IsRulerVisible}"
                             Unit="{Binding RulerUnit}"
                             Background="{DynamicResource SystemChromeLowColor}"
                             PageBrush="{DynamicResource SystemRegionColor}"
                             Foreground="{DynamicResource SystemBaseMediumHighColor}"
                             BorderBrush="{DynamicResource HairlineBrush}"
                             MarkerBrush="{DynamicResource AccentBrush}" />
      <controls:RulerControl x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" Width="20"
                             Orientation="Vertical"
                             IsVisible="{Binding IsRulerVisible}"
                             Unit="{Binding RulerUnit}"
                             Background="{DynamicResource SystemChromeLowColor}"
                             PageBrush="{DynamicResource SystemRegionColor}"
                             Foreground="{DynamicResource SystemBaseMediumHighColor}"
                             BorderBrush="{DynamicResource HairlineBrush}"
                             MarkerBrush="{DynamicResource AccentBrush}" />

      <Grid Grid.Row="1" Grid.Column="1">
      <ScrollViewer x:Name="PageScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource SystemChromeMediumColor}">
        <ScrollViewer.ContextMenu>
          <ContextMenu x:Name="PageContextMenu">
            <MenuItem Header="Delete" InputGesture="Delete" Command="{Binding DeleteSelectedAnnotationsCommand}"
                      IsVisible="{Binding HasSelectedAnnotation}" />
            <MenuItem Header="Properties" Command="{Binding OpenFormatPanelCommand}"
                      IsVisible="{Binding HasSelectedAnnotation}" />
            <Separator IsVisible="{Binding HasSelectedAnnotation}" />
            <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource ClipboardIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste in Place" InputGesture="Ctrl+Alt+V" Command="{Binding PasteInPlaceCommand}" />
            <Separator />
            <MenuItem Header="Read Mode" InputGesture="Ctrl+H" Command="{Binding Shell.ReadMode, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource ReadModeIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Full Screen" InputGesture="F11" Command="{Binding Shell.FullScreen, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource MinusIcon}" Width="12" Height="12" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Actual Size" InputGesture="Ctrl+1" Command="{Binding ActualSizeCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsActualSize}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Fit Page" InputGesture="Ctrl+0" Command="{Binding FitPageCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsFitPage}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Fit Width" InputGesture="Ctrl+2" Command="{Binding FitWidthCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsFitWidth}" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Rotate Right" InputGesture="Ctrl+Shift+OemPlus" Command="{Binding RotateClockwiseCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource RotatePageIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Print..." InputGesture="Ctrl+P" Command="{Binding Shell.Print, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource PrintIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Rulers" InputGesture="Ctrl+R" Command="{Binding ToggleRulerCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerVisible}" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ScrollViewer.ContextMenu>
        <ItemsControl x:Name="PagesHost"
                      ItemsSource="{Binding Pages}"
                      Margin="24"
                      HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PdfPageViewModel">
              <LayoutTransformControl Margin="0,0,0,12"
                                      HorizontalAlignment="Center"
                                      LayoutTransform="{Binding PageTransform}">
                <Border Width="{Binding DisplayWidth}"
                        Height="{Binding DisplayHeight}"
                        Background="White"
                        BoxShadow="0 2 10 0 #40000000">
                  <Grid>
                    <Image Source="{Binding Bitmap}" Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <controls:SelectionOverlay Rects="{Binding SearchRects}"
                                               PageWidthPoints="{Binding WidthPoints}"
                                               Fill="#59FFD400" />
                    <controls:SelectionOverlay Rects="{Binding CurrentMatchRects}"
                                               PageWidthPoints="{Binding WidthPoints}"
                                               Fill="#99FF8C00" />
                    <controls:SelectionOverlay Rects="{Binding SelectionRects}"
                                               PageWidthPoints="{Binding WidthPoints}" />
                    <controls:AnnotationOverlay Annotations="{Binding Annotations}"
                                                PageWidthPoints="{Binding WidthPoints}"
                                                DraftRect="{Binding DraftRect}"
                                                DraftCalloutTarget="{Binding DraftCalloutTarget}" />
                    <TextBlock Text="This page could not be rendered."
                               Foreground="#80000000"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasError}" />
                  </Grid>
                </Border>
              </LayoutTransformControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Canvas x:Name="PopupLayer" ClipToBounds="False">
        <views:SelectionPopup x:Name="SelectionPopupHost" IsVisible="False" />
        <views:AnnotationEditor x:Name="AnnotationEditorHost" IsVisible="False" />
        <views:NotePopup x:Name="NotePopupHost" IsVisible="False" />
        <views:NoteMiniBar x:Name="NoteMiniBarHost" IsVisible="False" />
        <views:MarkupMiniBar x:Name="MarkupMiniBarHost" IsVisible="False" />
      </Canvas>

      <views:FindBar x:Name="FindBarHost"
                     DataContext="{Binding Search}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,12,24,0" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
