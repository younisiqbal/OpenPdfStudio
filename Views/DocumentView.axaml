<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenPdfStudio.ViewModels"
             xmlns:views="using:OpenPdfStudio.Views"
             xmlns:controls="using:OpenPdfStudio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="OpenPdfStudio.Views.DocumentView"
             x:DataType="vm:DocumentViewModel"
             Focusable="True">

  <UserControl.Resources>
    <DataTemplate x:Key="PageFrameTemplate" x:DataType="vm:PdfPageViewModel">
      <LayoutTransformControl Classes="pageFrame"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Center"
                              LayoutTransform="{Binding PageTransform}">
        <Border Width="{Binding DisplayWidth}"
                Height="{Binding DisplayHeight}"
                Background="White"
                BoxShadow="0 2 10 0 #40000000">
          <Grid>
            <Image Source="{Binding Bitmap}" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <controls:SelectionOverlay Rects="{Binding SearchRects}"
                                       PageWidthPoints="{Binding WidthPoints}"
                                       Fill="#59FFD400" />
            <controls:SelectionOverlay Rects="{Binding CurrentMatchRects}"
                                       PageWidthPoints="{Binding WidthPoints}"
                                       Fill="#99FF8C00" />
            <controls:SelectionOverlay Rects="{Binding SelectionRects}"
                                       PageWidthPoints="{Binding WidthPoints}" />
            <controls:AnnotationOverlay Annotations="{Binding Annotations}"
                                        PageWidthPoints="{Binding WidthPoints}"
                                        DraftRect="{Binding DraftRect}" />
            <TextBlock Text="This page could not be rendered."
                       Foreground="#80000000"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasError}" />
          </Grid>
        </Border>
      </LayoutTransformControl>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.thumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
    </Style>
    <Style Selector="Button.thumb.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
    </Style>
    <Style Selector="Button.paneStrip">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.paneStrip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.paneStrip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.paneStrip.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Button.paneStrip PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="TextBlock.paneTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <views:ViewerBottomBar DockPanel.Dock="Bottom" IsVisible="{Binding ShowBottomBar}" />
    <Border DockPanel.Dock="Right" IsVisible="{Binding ShowFormatPanel}">
      <views:FormatPanel DataContext="{Binding Format}" />
    </Border>

    <Border DockPanel.Dock="Left" Width="44"
            IsVisible="{Binding ShowBottomBar}"
            Background="{DynamicResource AccentBrush}">
      <StackPanel Margin="0,8" Spacing="4">
        <Button Classes="paneStrip" Classes.active="{Binding IsPagesOpen}"
                Command="{Binding ToggleThumbnailsCommand}" ToolTip.Tip="Pages">
          <PathIcon Data="{StaticResource OutlineIcon}" />
        </Button>
        <Button Classes="paneStrip" Classes.active="{Binding IsBookmarksOpen}"
                Command="{Binding ToggleBookmarksCommand}" ToolTip.Tip="Bookmarks">
          <PathIcon Data="{StaticResource BookmarkIcon}" />
        </Button>
        <Button Classes="paneStrip"
                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FindCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="Search (Ctrl+F)">
          <PathIcon Data="{StaticResource SearchIcon}" />
        </Button>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left"
            IsVisible="{Binding ShowSidePanel}"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8,6,0">
          <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseSidePanelCommand}"
                  ToolTip.Tip="Close panel">
            <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" />
          </Button>
          <Panel VerticalAlignment="Center">
            <TextBlock Classes="paneTitle" Text="PAGES" IsVisible="{Binding ShowThumbnailPane}" />
            <TextBlock Classes="paneTitle" Text="BOOKMARKS" IsVisible="{Binding ShowBookmarkPane}" />
          </Panel>
        </DockPanel>

        <Panel>
          <ScrollViewer Width="152" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowThumbnailPane}">
            <ItemsControl x:Name="ThumbnailHost" ItemsSource="{Binding Pages}" Margin="0,12">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PdfPageViewModel">
                  <Button Classes="thumb" Classes.current="{Binding IsCurrent}"
                          Margin="0,0,0,8" Click="OnThumbnailClick"
                          ToolTip.Tip="{Binding PageNumber, StringFormat='Page {0}'}">
                    <StackPanel Spacing="4">
                      <LayoutTransformControl HorizontalAlignment="Center" LayoutTransform="{Binding PageTransform}">
                        <Border Width="{x:Static vm:PdfPageViewModel.ThumbnailWidth}"
                                Height="{Binding ThumbnailHeight}"
                                Background="White"
                                BoxShadow="0 1 4 0 #33000000">
                          <Image Source="{Binding Thumbnail}" Stretch="Fill" />
                        </Border>
                      </LayoutTransformControl>
                      <TextBlock Text="{Binding PageNumber}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <DockPanel Width="240" IsVisible="{Binding ShowBookmarkPane}">
            <Button DockPanel.Dock="Top" Classes="ghost" Margin="8,8,8,4" HorizontalAlignment="Stretch"
                    Command="{Binding AddBookmarkCommand}"
                    ToolTip.Tip="Bookmark the current page, or the selected text">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource BookmarkIcon}" Width="14" Height="14" />
                <TextBlock Text="Add bookmark" />
              </StackPanel>
            </Button>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,4,4,12" Spacing="4">
                <TextBlock Classes="hint" Text="Your bookmarks" Margin="8,6,8,2" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,6"
                           IsVisible="{Binding !HasUserBookmarks}"
                           Text="Select text and choose Bookmark, or use Add bookmark. OpenPdfStudio keeps them for this file." />
                <ItemsControl ItemsSource="{Binding UserBookmarkItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookmarkItemViewModel">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="result"
                                Command="{Binding $parent[UserControl].((vm:DocumentViewModel)DataContext).OpenBookmarkCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Title}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Margin="8,0,0,0"
                                       Text="{Binding PageLabel}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="icon"
                                Command="{Binding $parent[UserControl].((vm:DocumentViewModel)DataContext).RemoveBookmarkCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove this bookmark">
                          <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" Text="In this document" Margin="8,12,8,2" />
                <TextBlock Classes="muted" FontSize="12" Margin="8,0,8,6" Text="Loading..."
                           IsVisible="{Binding IsOutlineLoading}" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,6"
                           Text="This PDF has no bookmarks of its own.">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="!HasOutline" />
                      <Binding Path="!IsOutlineLoading" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding OutlineItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookmarkItemViewModel">
                      <Button Classes="result" Margin="{Binding Indent}"
                              IsEnabled="{Binding HasPage}"
                              Command="{Binding $parent[UserControl].((vm:DocumentViewModel)DataContext).OpenBookmarkCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding Title}">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Margin="8,0,0,0"
                                     Text="{Binding PageLabel}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>

    <Grid x:Name="PageArea" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Inches" Command="{Binding SetRulerUnitCommand}" CommandParameter="Inches">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerInches}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Centimeters" Command="{Binding SetRulerUnitCommand}" CommandParameter="Centimeters">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerCentimeters}" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Hide ruler" InputGesture="Ctrl+R" Command="{Binding ToggleRulerCommand}" />
        </ContextMenu>
      </Grid.ContextMenu>

      <Border x:Name="RulerCorner" Grid.Row="0" Grid.Column="0" Width="20" Height="20"
              IsVisible="{Binding IsRulerVisible}"
              Background="{DynamicResource SystemChromeLowColor}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,1" />
      <controls:RulerControl x:Name="TopRuler" Grid.Row="0" Grid.Column="1" Height="20"
                             Orientation="Horizontal"
                             IsVisible="{Binding IsRulerVisible}"
                             Unit="{Binding RulerUnit}"
                             Background="{DynamicResource SystemChromeLowColor}"
                             PageBrush="{DynamicResource SystemRegionColor}"
                             Foreground="{DynamicResource SystemBaseMediumHighColor}"
                             BorderBrush="{DynamicResource HairlineBrush}"
                             MarkerBrush="{DynamicResource AccentBrush}" />
      <controls:RulerControl x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" Width="20"
                             Orientation="Vertical"
                             IsVisible="{Binding IsRulerVisible}"
                             Unit="{Binding RulerUnit}"
                             Background="{DynamicResource SystemChromeLowColor}"
                             PageBrush="{DynamicResource SystemRegionColor}"
                             Foreground="{DynamicResource SystemBaseMediumHighColor}"
                             BorderBrush="{DynamicResource HairlineBrush}"
                             MarkerBrush="{DynamicResource AccentBrush}" />

      <Grid Grid.Row="1" Grid.Column="1">
      <ScrollViewer x:Name="PageScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource SystemChromeMediumColor}">
        <ScrollViewer.ContextMenu>
          <ContextMenu x:Name="PageContextMenu">
            <MenuItem Header="Delete" InputGesture="Delete" Command="{Binding DeleteSelectedAnnotationsCommand}"
                      IsVisible="{Binding HasSelectedAnnotation}" />
            <MenuItem Header="Properties" Command="{Binding OpenFormatPanelCommand}"
                      IsVisible="{Binding HasSelectedAnnotation}" />
            <Separator IsVisible="{Binding HasSelectedAnnotation}" />
            <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource ClipboardIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste in Place" InputGesture="Ctrl+Alt+V" Command="{Binding PasteInPlaceCommand}" />
            <Separator />
            <MenuItem Header="Read Mode" InputGesture="Ctrl+H" Command="{Binding Shell.ReadMode, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource ReadModeIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Full Screen" InputGesture="F11" Command="{Binding Shell.FullScreen, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource MinusIcon}" Width="12" Height="12" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Actual Size" InputGesture="Ctrl+1" Command="{Binding ActualSizeCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsActualSize}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Fit Page" InputGesture="Ctrl+0" Command="{Binding FitPageCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsFitPage}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Fit Width" InputGesture="Ctrl+2" Command="{Binding FitWidthCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsFitWidth}" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Rotate Right" InputGesture="Ctrl+Shift+OemPlus" Command="{Binding RotateClockwiseCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource RotatePageIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Print..." InputGesture="Ctrl+P" Command="{Binding Shell.Print, FallbackValue={x:Null}}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource PrintIcon}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Rulers" InputGesture="Ctrl+R" Command="{Binding ToggleRulerCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12" IsVisible="{Binding IsRulerVisible}" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ScrollViewer.ContextMenu>
        <Panel>
          <ItemsControl x:Name="PagesHost"
                        ItemsSource="{Binding Pages}"
                        ItemTemplate="{StaticResource PageFrameTemplate}"
                        IsVisible="{Binding IsContinuousLayout}"
                        Margin="24"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl x:Name="SpreadsHost"
                        ItemsSource="{Binding Spreads}"
                        IsVisible="{Binding UsesSpreads}"
                        Margin="24"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PageSpread">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                  <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource PageFrameTemplate}"
                                  VerticalAlignment="Top" />
                  <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource PageFrameTemplate}"
                                  IsVisible="{Binding HasRight}" VerticalAlignment="Top" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </ScrollViewer>

      <Canvas x:Name="PopupLayer" ClipToBounds="False">
        <Path x:Name="NoteConnector" Fill="#99FCE98A" Stroke="#D6C24A" StrokeThickness="1"
              IsHitTestVisible="False" IsVisible="False" />
        <views:SelectionPopup x:Name="SelectionPopupHost" IsVisible="False" />
        <views:AnnotationEditor x:Name="AnnotationEditorHost" IsVisible="False" />
        <views:NotePopup x:Name="NotePopupHost" IsVisible="False" />
        <views:NoteMiniBar x:Name="NoteMiniBarHost" IsVisible="False" />
        <views:MarkupMiniBar x:Name="MarkupMiniBarHost" IsVisible="False" />
      </Canvas>

      <views:FindBar x:Name="FindBarHost"
                     DataContext="{Binding Search}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,12,24,0" />
      </Grid>

      <views:OrganizePagesView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" />
    </Grid>
  </DockPanel>
</UserControl>
