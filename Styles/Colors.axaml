<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:OpenPdfStudio.Themes">

  <SolidColorBrush x:Key="PdfBadgeBrush" Color="#C8372D" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AccentBrush" Color="#0E7C86" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#12939E" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="DropFillBrush" Color="#260E7C86" />
      <SolidColorBrush x:Key="NavActiveBrush" Color="#330E7C86" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#33FFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AccentBrush" Color="#0E7C86" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B6870" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="DropFillBrush" Color="#140E7C86" />
      <SolidColorBrush x:Key="NavActiveBrush" Color="#220E7C86" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#1F000000" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static themes:AppThemes.Midnight}">
      <Color x:Key="SystemRegionColor">#0B1220</Color>
      <Color x:Key="SystemChromeLowColor">#111A2E</Color>
      <Color x:Key="SystemChromeMediumColor">#1B2742</Color>
      <Color x:Key="SystemBaseLowColor">#2A3654</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#14A3AD" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1BBCC7" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="DropFillBrush" Color="#2614A3AD" />
      <SolidColorBrush x:Key="NavActiveBrush" Color="#3314A3AD" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#2E8FA8D6" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static themes:AppThemes.HighContrast}">
      <Color x:Key="SystemRegionColor">#000000</Color>
      <Color x:Key="SystemChromeLowColor">#0A0A0A</Color>
      <Color x:Key="SystemChromeMediumColor">#262626</Color>
      <Color x:Key="SystemBaseLowColor">#A0A0A0</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#FFD400" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFE45C" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="Black" />
      <SolidColorBrush x:Key="DropFillBrush" Color="#1FFFD400" />
      <SolidColorBrush x:Key="NavActiveBrush" Color="#40FFD400" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#B3FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

