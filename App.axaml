<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenPdfStudio.App"
             xmlns:local="using:OpenPdfStudio"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OpenPdfStudio/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://OpenPdfStudio/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The main window draws its own title bar and caption buttons. -->
            <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
                <Setter Property="DefaultTitleBarHeight" Value="36" />
                <Setter Property="DefaultFrameThickness" Value="0" />
                <Setter Property="DefaultShadowThickness" Value="0" />
                <Setter Property="Template">
                    <WindowDrawnDecorationsTemplate>
                        <WindowDrawnDecorationsContent>
                            <WindowDrawnDecorationsContent.Underlay>
                                <Panel IsHitTestVisible="False" />
                            </WindowDrawnDecorationsContent.Underlay>
                            <WindowDrawnDecorationsContent.Overlay>
                                <Panel IsHitTestVisible="False" />
                            </WindowDrawnDecorationsContent.Overlay>
                        </WindowDrawnDecorationsContent>
                    </WindowDrawnDecorationsTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OpenPdfStudio/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
